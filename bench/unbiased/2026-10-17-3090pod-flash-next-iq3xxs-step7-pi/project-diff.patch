+"""Tests for wordstats.py."""
+import json
+import subprocess
+import sys
+import unittest
+from collections import Counter
+
+from wordstats import count_words, main
+
+
+class CountWordsTests(unittest.TestCase):
+    def test_basic_counts(self):
+        self.assertEqual(
+            count_words("the sea is wide and the sea is deep"),
+            Counter({"the": 2, "sea": 2, "is": 2, "wide": 1, "and": 1, "deep": 1}),
+        )
+
+    def test_case_folding_and_punctuation(self):
+        self.assertEqual(
+            count_words("Sea, sea! SEA? (wide)"),
+            Counter({"sea": 3, "wide": 1}),
+        )
+
+    def test_empty_text(self):
+        self.assertEqual(count_words(""), Counter())
+
+
+class TableOutputTests(unittest.TestCase):
+    def test_default_table_output(self, ):
+        proc = subprocess.run(
+            [sys.executable, "wordstats.py", "sample.txt"],
+            capture_output=True, text=True, check=True,
+        )
+        lines = proc.stdout.splitlines()
+        self.assertEqual(lines[0], "     3  the")
+        self.assertEqual(lines[1], "     3  is")
+        self.assertEqual(lines[2], "     2  sea")
+        self.assertEqual(len(lines), 8)  # sample.txt has 8 distinct words
+
+    def test_no_args_exits_2(self):
+        proc = subprocess.run(
+            [sys.executable, "wordstats.py"],
+            capture_output=True, text=True,
+        )
+        self.assertEqual(proc.returncode, 2)
+        self.assertIn("usage", proc.stderr)
+
+
+class JsonOutputTests(unittest.TestCase):
+    def test_json_output(self):
+        proc = subprocess.run(
+            [sys.executable, "wordstats.py", "--json", "sample.txt"],
+            capture_output=True, text=True, check=True,
+        )
+        data = json.loads(proc.stdout)
+        self.assertEqual(
+            data,
+            {"the": 3, "sea": 2, "is": 3, "wide": 1, "and": 1,
+             "deep": 1, "boat": 1, "small": 1},
+        )
+
+    def test_json_flag_does_not_affect_count_words(self):
+        # main() with --json should still return 0 and consume the flag
+        self.assertEqual(main(["--json", "sample.txt"]), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
