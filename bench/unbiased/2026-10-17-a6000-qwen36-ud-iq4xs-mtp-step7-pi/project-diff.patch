+"""Tests for wordstats.py."""
+import json
+import subprocess
+import sys
+import unittest
+
+SCRIPT = [sys.executable, "wordstats.py"]
+
+
+class CountWordsTest(unittest.TestCase):
+    """Tests for the count_words function."""
+
+    def test_basic(self):
+        from wordstats import count_words
+        c = count_words("one two three two one one")
+        self.assertEqual(c["one"], 3)
+        self.assertEqual(c["two"], 2)
+        self.assertEqual(c["three"], 1)
+
+    def test_punctuation_stripped(self):
+        from wordstats import count_words
+        c = count_words('"Hello," world!')
+        self.assertEqual(c["hello"], 1)
+        self.assertEqual(c["world"], 1)
+
+    def test_case_insensitive(self):
+        from wordstats import count_words
+        c = count_words("Hello hello HELLO")
+        self.assertEqual(c["hello"], 3)
+
+    def test_empty_text(self):
+        from wordstats import count_words
+        c = count_words("")
+        self.assertEqual(len(c), 0)
+
+
+class DefaultTableOutputTest(unittest.TestCase):
+    """Tests that the default (non-JSON) output prints a top-10 table."""
+
+    def test_default_shows_top_words(self):
+        result = subprocess.run(SCRIPT + ["sample.txt"], capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0)
+        lines = result.stdout.strip().splitlines()
+        # Should have at least one line of output
+        self.assertGreater(len(lines), 0)
+        # Each line should start with a number (the count)
+        for line in lines:
+            self.assertTrue(line[0].isdigit() or line[0] == " ",
+                            f"Unexpected line: {line!r}")
+
+    def test_default_limited_to_10(self):
+        # Create a temp file with many unique words
+        import tempfile, os
+        words = " ".join(f"word{i}" for i in range(15))
+        with tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False, dir=".") as f:
+            f.write(words)
+            tmp = f.name
+        try:
+            result = subprocess.run(SCRIPT + [tmp], capture_output=True, text=True)
+            self.assertEqual(result.returncode, 0)
+            lines = result.stdout.strip().splitlines()
+            self.assertLessEqual(len(lines), 10)
+        finally:
+            os.unlink(tmp)
+
+    def test_no_args_exits_2(self):
+        result = subprocess.run(SCRIPT, capture_output=True, text=True)
+        self.assertEqual(result.returncode, 2)
+
+
+class JsonOutputTest(unittest.TestCase):
+    """Tests for the --json flag output."""
+
+    def test_json_output_is_valid(self):
+        result = subprocess.run(SCRIPT + ["--json", "sample.txt"], capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0)
+        data = json.loads(result.stdout)
+        self.assertIsInstance(data, dict)
+
+    def test_json_contains_expected_words(self):
+        result = subprocess.run(SCRIPT + ["--json", "sample.txt"], capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0)
+        data = json.loads(result.stdout)
+        self.assertIn("the", data)
+        self.assertIn("sea", data)
+        self.assertIn("is", data)
+
+    def test_json_all_words_not_just_top10(self):
+        import tempfile, os
+        words = " ".join(f"word{i}" for i in range(15))
+        with tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False, dir=".") as f:
+            f.write(words)
+            tmp = f.name
+        try:
+            result = subprocess.run(SCRIPT + ["--json", tmp], capture_output=True, text=True)
+            self.assertEqual(result.returncode, 0)
+            data = json.loads(result.stdout)
+            # --json should include ALL words, not just top 10
+            self.assertEqual(len(data), 15)
+        finally:
+            os.unlink(tmp)
+
+    def test_json_sorted_keys(self):
+        result = subprocess.run(SCRIPT + ["--json", "sample.txt"], capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0)
+        data = json.loads(result.stdout)
+        keys = list(data.keys())
+        self.assertEqual(keys, sorted(keys))
+
+
+if __name__ == "__main__":
+    unittest.main()
